{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steer/ps1_claims/1.1",
  "title": "claims.json v1.1: everything the PS1 quiz may draw. Written by `steer ps1 build` from verified (or S4-cleared) claims and copy that passed the PS2 checks. The page draws no other text and never formats a revealed number: scale stops and reveals are strings from here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "built_at",
    "brand",
    "ui",
    "hook",
    "doubts",
    "rounds",
    "gap_cards",
    "readout",
    "doctor_questions",
    "cta",
    "warm_lead",
    "points"
  ],
  "properties": {
    "version": {
      "const": "1.1"
    },
    "built_at": {
      "type": "string",
      "description": "ISO time of the build (shown in the footer)"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "fonts",
        "wordmark",
        "signoff",
        "footer"
      ],
      "properties": {
        "palette": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "serif",
            "serif_italic",
            "sans"
          ],
          "properties": {
            "serif": {
              "type": "string"
            },
            "serif_italic": {
              "type": "string"
            },
            "sans": {
              "type": "string"
            }
          }
        },
        "wordmark": {
          "type": "string"
        },
        "signoff": {
          "type": "string"
        },
        "footer": {
          "type": "string",
          "description": "'Educational prototype · content pending review by a Steer doctor · not a medical assessment'"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "you_guessed",
        "see_quote",
        "hide_quote",
        "next",
        "pick_worries",
        "pick_hint",
        "start_rounds",
        "done",
        "readout_title",
        "questions_title",
        "restart",
        "progress",
        "progress_first",
        "study_range",
        "result_closest",
        "result_close",
        "result_different",
        "score_label",
        "streak_label",
        "worth_a_chat",
        "unscored",
        "share_make",
        "share_line",
        "share_note",
        "copied"
      ],
      "description": "fixed button and heading words, checked as framing copy (no numbers, no health assertion)"
    },
    "hook": {
      "$ref": "#/$defs/round",
      "description": "the first round (answers the doubt 'is_it_for_me'); one tap on a bin is the guess"
    },
    "doubts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "answered_by"
        ],
        "properties": {
          "id": {
            "enum": [
              "is_it_safe",
              "will_i_lose_muscle",
              "will_weight_come_back",
              "only_for_diabetics",
              "is_it_for_me"
            ]
          },
          "label": {
            "type": "string",
            "description": "the chip text, from the doc's five doubts"
          },
          "answered_by": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "round ids (played in order), ['hook'], or one gap card id"
          }
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "gap_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "opener"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "opener": {
            "type": "string",
            "description": "daily-life framing line above the card"
          },
          "context": {
            "type": [
              "string",
              "null"
            ],
            "description": "info card only: the paper's own gate-checked population sentence, as a context line"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "short"
            ],
            "properties": {
              "short": {
                "type": "string"
              }
            },
            "description": "info card with a context line: the short cite of the paper that sentence comes from"
          }
        }
      }
    },
    "readout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numbers",
        "direction",
        "meaning_title"
      ],
      "properties": {
        "numbers": {
          "type": "string",
          "description": "number rounds only, template with {n} and {m}: count of \"Closest range\" results; no count line when no number round was answered"
        },
        "direction": {
          "type": "string",
          "description": "template with {n} and {m}: direction rounds (choices), scored separately"
        },
        "meaning_title": {
          "type": "string",
          "description": "'What these studies tell us — and what they don't' (then the revealed sentences with their qualifiers and short cites)"
        }
      }
    },
    "doctor_questions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "doubt id -> questions to take to a doctor (questions, never claims)"
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/link",
          "description": "'See if the programme fits you'; url carries only utm_source=steer_quiz&utm_campaign=guess_the_number; the page adds NOTHING to it (no user state in any URL)"
        },
        "secondary": {
          "$ref": "#/$defs/link",
          "description": "'Talk to a Steer doctor'"
        }
      }
    },
    "warm_lead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "note",
        "doubts_label",
        "guesses_label",
        "name_label",
        "phone_label",
        "consent_label",
        "show_label",
        "preview_title",
        "copy_label",
        "share_label",
        "share_title",
        "consent_short",
        "yes_label",
        "your_guess",
        "the_study"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "'What Steer's team would see'"
        },
        "note": {
          "type": "string",
          "description": "the exact demo label: 'Prototype only. Nothing is sent or stored. Use test details, not real contact information.'"
        },
        "doubts_label": {
          "type": "string"
        },
        "guesses_label": {
          "type": "string"
        },
        "name_label": {
          "type": "string"
        },
        "phone_label": {
          "type": "string"
        },
        "consent_label": {
          "type": "string"
        },
        "show_label": {
          "type": "string"
        },
        "preview_title": {
          "type": "string"
        },
        "copy_label": {
          "type": "string"
        },
        "share_label": {
          "type": "string"
        },
        "share_title": {
          "type": "string"
        },
        "consent_short": {
          "type": "string"
        },
        "yes_label": {
          "type": "string"
        },
        "your_guess": {
          "type": "string"
        },
        "the_study": {
          "type": "string"
        }
      }
    },
    "points": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closest",
        "close",
        "different"
      ],
      "properties": {
        "closest": {
          "type": "integer",
          "minimum": 0
        },
        "close": {
          "type": "integer",
          "minimum": 0
        },
        "different": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "points per result, deterministic; numbers, never drawn as copy"
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "reveal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "label",
        "sentence"
      ],
      "properties": {
        "number": {
          "type": "string",
          "description": "the revealed number, an EXACT substring of sentence (drawn large); empty when the round reveals no number (the label is drawn large instead)"
        },
        "label": {
          "type": "string",
          "description": "what it measures, an EXACT substring of sentence (drawn beside the number)"
        },
        "sentence": {
          "type": "string",
          "description": "the checked plain sentence (a health line that passed the PS2 checks)"
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "doubt",
        "kind",
        "context",
        "question",
        "stops",
        "answer",
        "reveals",
        "qualifiers",
        "quote",
        "source",
        "claim_ids",
        "opener",
        "prompt",
        "design"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "doubt": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "slider",
            "choice"
          ],
          "description": "every round is one tap on a bin/choice; \"slider\" is legacy and drawn the same way. A numeric-valued stops list is a bin scale (value = lower end), scored closest / close (one bin off) / different"
        },
        "question": {
          "type": "string",
          "description": "the framing question (no numbers, no health assertion)"
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "drawn as is, e.g. '2×' or 'Up'"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "compared only, never drawn"
              }
            }
          },
          "description": "slider stops (ordered) or choices; a choice with numeric values is a bin scale (value = lower end of the bin, compared never drawn); the page starts on no stop, never on the answer"
        },
        "answer": {
          "type": [
            "number",
            "string"
          ],
          "description": "compared with a stop's value for the readout; never drawn"
        },
        "reveals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reveal"
          },
          "description": "one, or a pair shown together (the Laverde lean-mass pair)"
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "boundary qualifiers drawn with the reveal ('an average across studies, not a prediction for you')"
        },
        "quote": {
          "type": "string",
          "description": "the exact quote(s) from the paper, behind 'see the exact sentence'"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "short",
            "full",
            "location",
            "doi"
          ],
          "properties": {
            "short": {
              "type": "string"
            },
            "full": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "doi": {
              "type": "string"
            }
          }
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "run/claim keys (trace only, not drawn)"
        },
        "context": {
          "type": [
            "string",
            "null"
          ],
          "description": "who and what was studied, built from the paper's boundaries qualifiers and context quotes (the only place numbers appear outside stops and reveals), e.g. 'Adults aged 45+ in Chennai, Delhi and Karachi · BMI below 25 · South Asian women vs US white women'"
        },
        "opener": {
          "type": "string",
          "description": "one daily-life framing line above the question: no health fact, no number, no attribute the claim does not state"
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ],
          "description": "small guess prompt right above the buttons (framing)"
        },
        "design": {
          "enum": [
            "single_study",
            "review"
          ],
          "description": "the paper's design: only single studies carry the one-study note"
        }
      }
    }
  }
}
