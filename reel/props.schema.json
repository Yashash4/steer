{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steer/reel_props/3",
  "title": "reel_props.json v3: everything the Remotion composition may draw or play. Written by `steer reel` (Python) after the post's checks; every string in it is a checked script line (or an exact substring of one) or a string built by code. The composition draws no other text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fps",
    "width",
    "height",
    "durationInFrames",
    "audio",
    "fonts",
    "palette",
    "chrome",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "fps": {
      "const": 30
    },
    "width": {
      "const": 1080
    },
    "height": {
      "const": 1920
    },
    "durationInFrames": {
      "type": "integer",
      "minimum": 1
    },
    "audio": {
      "type": "string",
      "description": "the voice track, a WAV in the render's public folder"
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serif",
        "serif_italic",
        "sans"
      ],
      "properties": {
        "serif": {
          "type": "string"
        },
        "serif_italic": {
          "type": "string"
        },
        "sans": {
          "type": "string"
        }
      },
      "description": "font files in the public folder (Fraunces, Fraunces italic, Inter); loaded with staticFile(), never from the network"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cream",
        "rust",
        "maroon",
        "ink",
        "clay",
        "blush",
        "paper"
      ],
      "properties": {
        "cream": {
          "$ref": "#/$defs/hex"
        },
        "rust": {
          "$ref": "#/$defs/hex"
        },
        "maroon": {
          "$ref": "#/$defs/hex"
        },
        "ink": {
          "$ref": "#/$defs/hex"
        },
        "clay": {
          "$ref": "#/$defs/hex"
        },
        "blush": {
          "$ref": "#/$defs/hex"
        },
        "paper": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_mark",
        "wordmark"
      ],
      "properties": {
        "draft_mark": {
          "type": "string",
          "description": "shown on every frame: 'draft · pending doctor review'"
        },
        "wordmark": {
          "type": "string",
          "description": "'steer'"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ground",
        "start",
        "end",
        "transition_in",
        "broll",
        "presenter",
        "lines",
        "sources",
        "captions",
        "zoom",
        "checklist",
        "pullback",
        "sources_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hook",
            "point",
            "brand",
            "cta",
            "status",
            "checklist",
            "pullback",
            "sources"
          ]
        },
        "ground": {
          "enum": [
            "cream",
            "rust",
            "maroon"
          ]
        },
        "start": {
          "$ref": "#/$defs/seconds"
        },
        "end": {
          "$ref": "#/$defs/seconds"
        },
        "transition_in": {
          "enum": [
            "wipe",
            "none",
            "zoom"
          ]
        },
        "broll": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "video",
                "start",
                "end"
              ],
              "properties": {
                "video": {
                  "type": "string",
                  "description": "broll-<name>.mp4, muted, in the public folder"
                },
                "start": {
                  "$ref": "#/$defs/seconds"
                },
                "end": {
                  "$ref": "#/$defs/seconds"
                }
              }
            }
          ],
          "description": "a b-roll clip behind the scene (edit_plan; never food behind a health or number line)"
        },
        "presenter": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "video",
                "start",
                "end",
                "label"
              ],
              "properties": {
                "video": {
                  "type": "string",
                  "description": "a muted MP4 in the render's public folder (the voice is always our checked TTS track)"
                },
                "start": {
                  "$ref": "#/$defs/seconds"
                },
                "end": {
                  "$ref": "#/$defs/seconds"
                },
                "label": {
                  "const": "AI-generated presenter · not a Steer clinician",
                  "description": "drawn whenever the presenter is on screen (D-026)"
                }
              }
            }
          ],
          "description": "D-026: a talking presenter clip filling the frame behind the scene's text; null = motion graphics only"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "description": "empty for the sources scene"
        },
        "sources": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sources"
            }
          ],
          "description": "the end card (kind sources only)"
        },
        "captions": {
          "type": "boolean",
          "description": "chunked captions (the beats) instead of the full-line layout"
        },
        "zoom": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "dur",
              "scale"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/seconds"
              },
              "dur": {
                "type": "number",
                "minimum": 0
              },
              "scale": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.2
              }
            }
          }
        },
        "checklist": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "items"
              ],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "at"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "at": {
                        "$ref": "#/$defs/seconds"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "pullback": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "the studio screenshot file"
        },
        "sources_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/seconds"
            }
          ],
          "description": "v5: the cta scene shows the pull-back, then the sources card from this time (under the voice)"
        },
        "lineart": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "frames",
                "at",
                "dur"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "frames": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "at": {
                  "$ref": "#/$defs/seconds"
                },
                "dur": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            }
          ],
          "description": "v5: a code-chosen drawing (code/lineart) drawn on stroke by stroke under the sources card, then held"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "start",
        "end",
        "hold_end",
        "beats",
        "emphasis",
        "key",
        "source_label",
        "cards",
        "evidence",
        "cards_style"
      ],
      "properties": {
        "kind": {
          "enum": [
            "health",
            "framing",
            "brand",
            "cta",
            "signoff",
            "status",
            "setting"
          ]
        },
        "text": {
          "type": "string",
          "description": "the checked line, verbatim, in display form (number and unit joined by a no-break space, kg/m2 as kg/m²): drawn whole during the hold"
        },
        "start": {
          "$ref": "#/$defs/seconds"
        },
        "end": {
          "$ref": "#/$defs/seconds",
          "description": "the voice finishes the line"
        },
        "hold_end": {
          "$ref": "#/$defs/seconds",
          "description": "the whole line stays on screen, every word at full ink, from end to hold_end (>= end + 0.8 s for health lines)"
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "start",
              "words"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "2-4 consecutive words of the line, an exact substring of text"
              },
              "start": {
                "$ref": "#/$defs/seconds",
                "description": "the voice reaches the beat's first word"
              },
              "words": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "start"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "start": {
                      "$ref": "#/$defs/seconds"
                    }
                  }
                }
              }
            }
          }
        },
        "emphasis": {
          "type": [
            "string",
            "null"
          ],
          "description": "hook only: words of the line to set in rust italic (the post's checked emphasis)"
        },
        "key": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "number",
                "label",
                "at"
              ],
              "properties": {
                "number": {
                  "type": "string",
                  "description": "the checked key_number, an exact substring of text"
                },
                "label": {
                  "type": "string",
                  "description": "the checked key_label, an exact substring of text; always drawn with the number"
                },
                "at": {
                  "$ref": "#/$defs/seconds",
                  "description": "the voice reaches the number"
                }
              }
            }
          ]
        },
        "source_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "health lines: the short source built by code, e.g. 'West et al. 2026, section text, no page layout'"
        },
        "cards": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "parts"
                ],
                "properties": {
                  "start": {
                    "$ref": "#/$defs/seconds"
                  },
                  "parts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "text",
                        "role",
                        "show",
                        "at"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "description": "an exact run of the line's display words; all parts in order = the line"
                        },
                        "role": {
                          "enum": [
                            "setting",
                            "hero",
                            "text"
                          ]
                        },
                        "show": {
                          "type": "string",
                          "description": "what is drawn: text itself, or for a hero the one transform 'N times' -> 'N×'"
                        },
                        "at": {
                          "$ref": "#/$defs/seconds"
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "description": "a long health line as 2 cards split by code at its first colon (setting, then findings with hero numbers); null = phrase build-up"
        },
        "evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "header",
                "quote",
                "image",
                "boxes",
                "start",
                "end"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "page",
                    "quote"
                  ]
                },
                "header": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "image": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "boxes": {
                  "type": "array"
                },
                "start": {
                  "$ref": "#/$defs/seconds"
                },
                "end": {
                  "$ref": "#/$defs/seconds"
                }
              }
            }
          ]
        },
        "cards_style": {
          "enum": [
            "split",
            "stack"
          ]
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "entries",
        "footnote",
        "url"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "description": "'Sources'"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "journal",
              "after"
            ],
            "properties": {
              "before": {
                "type": "string",
                "description": "built by code: 'West S, Scragg J, Aveyard P et al. <title>.'"
              },
              "journal": {
                "type": "string",
                "description": "the journal's display name, drawn in italic"
              },
              "after": {
                "type": "string",
                "description": "built by code: ', 2026. doi:10.1136/bmj-2025-085304. Section text, no page layout.'"
              }
            }
          }
        },
        "footnote": {
          "type": "string",
          "description": "'Every claim on these slides is linked to the paper. Pending review by a Steer doctor before publishing.'"
        },
        "url": {
          "type": "string",
          "description": "'steerclub.com'"
        },
        "url_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/seconds"
            }
          ],
          "description": "v5: when the URL line enters (a visual change on the held card); null = shown with the card"
        }
      }
    }
  }
}
